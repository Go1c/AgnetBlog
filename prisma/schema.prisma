generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  BLOG
  DOCS
}

enum Visibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum SyncTrigger {
  WEBHOOK
  SCHEDULED
  MANUAL
  AI
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ActorType {
  ADMIN
  AI
  SYSTEM
}

enum ShareAccessMode {
  LINK
  PASSWORD
}

enum ShareNavigationScope {
  CURRENT_ONLY
  NAVIGABLE
}

enum CommentStatus {
  ACTIVE
  DELETED
}

model AdminUser {
  id          String     @id @default(cuid())
  email       String?
  githubLogin String     @unique
  displayName String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  aiTokens    AiToken[]
  auditLogs   AuditLog[]
}

model DirectoryPolicy {
  id                String     @id @default(cuid())
  path              String     @unique
  contentType       ContentType
  defaultVisibility Visibility @default(PRIVATE)
  syncEnabled       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([contentType])
}

model ContentItem {
  id           String         @id @default(cuid())
  type         ContentType
  slug         String
  title        String
  description  String?
  body         String?
  tags         String[]       @default([])
  sourcePath   String         @unique
  sourceHash   String?
  visibility   Visibility     @default(PRIVATE)
  published    Boolean        @default(false)
  publishedAt  DateTime?
  syncedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assets       ContentAsset[]
  comments     ContentComment[]
  docsNavNodes DocsNavNode[]
  shares       ContentShare[]

  @@unique([type, slug])
  @@index([type])
  @@index([visibility])
  @@index([published])
  @@index([sourcePath])
}

model ContentShare {
  id              String               @id @default(cuid())
  contentItemId   String
  token           String               @unique
  accessMode      ShareAccessMode      @default(LINK)
  navigationScope ShareNavigationScope @default(CURRENT_ONLY)
  passwordHash    String?
  passwordSalt    String?
  createdByLogin  String?
  lastAccessedAt  DateTime?
  revokedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  contentItem     ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, revokedAt])
  @@index([token])
}

model ContentComment {
  id                  String           @id @default(cuid())
  contentItemId       String?
  targetKey           String?
  parentId            String?
  displayName         String?
  body                String
  status              CommentStatus    @default(ACTIVE)
  deletedAt           DateTime?
  deletedByAdminLogin String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  contentItem         ContentItem?     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  parent              ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies             ContentComment[] @relation("CommentReplies")

  @@index([contentItemId, status, createdAt])
  @@index([targetKey, status, createdAt])
  @@index([parentId])
}

model ContentAsset {
  id            String      @id @default(cuid())
  contentItemId String
  sourcePath    String
  publicPath    String
  mimeType      String?
  sizeBytes     Int?
  sourceHash    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, sourcePath])
  @@index([sourcePath])
}

model DocsNavNode {
  id            String        @id @default(cuid())
  contentItemId String?
  parentId      String?
  slug          String
  path          String        @unique
  title         String
  sourcePath    String?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contentItem   ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  parent        DocsNavNode?  @relation("DocsNavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      DocsNavNode[] @relation("DocsNavTree")

  @@unique([parentId, slug])
  @@index([contentItemId])
  @@index([parentId, order])
  @@index([path])
  @@index([sourcePath])
}

model SyncJob {
  id           String      @id @default(cuid())
  trigger      SyncTrigger
  status       SyncStatus  @default(QUEUED)
  requestedBy  String?
  sourceRef    String?
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  result       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([trigger])
  @@index([createdAt])
}

model AiToken {
  id               String     @id @default(cuid())
  name             String
  tokenHash        String     @unique
  scopes           String[]   @default([])
  createdByAdminId String?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  auditLogs        AuditLog[]

  @@index([createdByAdminId])
}

model AuditLog {
  id          String     @id @default(cuid())
  actorType   ActorType
  adminUserId String?
  aiTokenId   String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  aiToken     AiToken?    @relation(fields: [aiTokenId], references: [id], onDelete: SetNull)

  @@index([actorType, createdAt])
  @@index([adminUserId])
  @@index([aiTokenId])
  @@index([targetType, targetId])
}
